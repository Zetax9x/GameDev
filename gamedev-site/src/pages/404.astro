---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
---
<BaseLayout lang="en" title={`${t('en', 'notFound.title')} · ${t('it', 'notFound.title')}`} alternateHref="/it/" hasAlternate={false} noindex>
  <div class="container-site grid gap-10 pt-24 md:grid-cols-2">
    <section>
      <p class="font-mono text-xs text-accent">404</p>
      <h1 class="mt-2 text-2xl">{t('en', 'notFound.title')}</h1>
      <p class="mt-3 text-muted">{t('en', 'notFound.text')}</p>
      <a href="/en/" class="btn btn-primary mt-6">{t('en', 'notFound.home')}</a>
    </section>
    <section lang="it">
      <p class="font-mono text-xs text-muted">404</p>
      <h2 class="mt-2 text-2xl">{t('it', 'notFound.title')}</h2>
      <p class="mt-3 text-muted">{t('it', 'notFound.text')}</p>
      <a href="/it/" class="btn mt-6">{t('it', 'notFound.home')}</a>
    </section>
  </div>
</BaseLayout>
