---
import type { GetStaticPaths } from 'astro';
import PostPage from '../../../components/pages/PostPage.astro';
import MissingTranslationPage from '../../../components/pages/MissingTranslationPage.astro';
import { devlogPaths, type DevlogPathProps } from '../../../lib/static-paths';

export const getStaticPaths = (() => devlogPaths('it')) satisfies GetStaticPaths;
const { post, missing } = Astro.props as DevlogPathProps;
---
{missing ? <MissingTranslationPage lang="it" original={post} /> : <PostPage lang="it" post={post} />}
