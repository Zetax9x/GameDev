---
// Private area (Italian only). Static shell: every datum is loaded by the React island
// from /api/private/*, so nothing private ends up in the built HTML.
import '../styles/global.css';
import ThemeScript from '../components/layout/ThemeScript.astro';
import ThemeToggle from '../components/layout/ThemeToggle.astro';

interface Props {
  title: string;
  active: 'panoramica' | 'registra' | 'settimane' | 'traguardi' | 'impostazioni';
}
const { title, active } = Astro.props;

const nav = [
  { id: 'panoramica', href: '/dashboard/', label: 'Panoramica', icon: 'M3 12l9-8 9 8M5 10v10h14V10' },
  { id: 'registra', href: '/dashboard/registra/', label: 'Registra', icon: 'M12 5v14M5 12h14' },
  { id: 'settimane', href: '/dashboard/settimane/', label: 'Settimane', icon: 'M4 6h16M4 12h16M4 18h10' },
  { id: 'traguardi', href: '/dashboard/traguardi/', label: 'Traguardi', icon: 'M5 21V4h11l-1.5 4L16 12H5' },
] as const;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0E0F12" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Studio" />
    <title>{title} · Dashboard</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ThemeScript />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent">
      Vai al contenuto
    </a>
    <header class="sticky top-0 z-20 border-b border-border bg-bg/95 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-xl items-center justify-between gap-3 px-4 md:max-w-3xl">
        <a href="/dashboard/" class="font-display font-semibold no-underline">Dashboard</a>
        <nav aria-label="Area privata" class="hidden md:block">
          <ul class="flex gap-1 text-sm">
            {
              [...nav, { id: 'impostazioni', href: '/dashboard/impostazioni/', label: 'Impostazioni' }].map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={active === item.id ? 'page' : undefined}
                    class:list={['rounded-full px-3 py-2 no-underline', active === item.id ? 'text-text' : 'text-muted hover:text-text']}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="flex items-center gap-2">
          <a
            href="/dashboard/impostazioni/"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border text-muted md:hidden"
            aria-label="Impostazioni"
            aria-current={active === 'impostazioni' ? 'page' : undefined}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"></path>
            </svg>
          </a>
          <ThemeToggle label="Cambia tema chiaro/scuro" />
        </div>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-xl px-4 pt-6 pb-28 md:max-w-3xl md:pb-12">
      <h1 class="mb-5 text-xl">{title}</h1>
      <slot />
      <noscript><p class="text-danger">La dashboard richiede JavaScript.</p></noscript>
    </main>

    <!-- Bottom navigation on phones, one-handed. -->
    <nav aria-label="Area privata" class="fixed inset-x-0 bottom-0 z-20 border-t border-border bg-surface pb-[env(safe-area-inset-bottom)] md:hidden">
      <ul class="mx-auto grid h-16 max-w-xl grid-cols-4">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={active === item.id ? 'page' : undefined}
                class:list={[
                  'flex h-full flex-col items-center justify-center gap-1 text-xs no-underline',
                  active === item.id ? 'text-accent' : 'text-muted',
                ]}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={item.icon} />
                </svg>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </body>
</html>
