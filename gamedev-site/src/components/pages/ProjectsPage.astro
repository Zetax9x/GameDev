---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../public/ProjectCard.astro';
import { t, path, otherLang, type Lang } from '../../i18n';
import { getProjects, PROJECT_STATUSES } from '../../lib/projects';
import { PHASES, phaseName } from '../../lib/content-data';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const projects = await getProjects();
const phaseIds = new Set(projects.map((p) => p.data.phase_id));
const phases = PHASES.filter((p) => phaseIds.has(p.id));
---
<BaseLayout lang={lang} title={t(lang, 'projects.title')} alternateHref={path(otherLang(lang), 'projects')} current="projects">
  <div class="container-site pt-16">
    <h1 class="text-2xl md:text-3xl">{t(lang, 'projects.title')}</h1>
    <p class="mt-3 max-w-xl text-muted">{t(lang, 'projects.intro')}</p>

    <!-- Filters: without JavaScript every project stays visible. -->
    <form class="project-filters mt-8 flex flex-wrap gap-4" hidden>
      <label class="flex flex-col gap-1 text-sm">
        <span class="text-muted">{t(lang, 'projects.filterStatus')}</span>
        <select name="status" class="h-11 rounded-full border border-border bg-surface px-4">
          <option value="">{t(lang, 'projects.all')}</option>
          {PROJECT_STATUSES.map((s) => <option value={s}>{t(lang, `projects.status.${s}`)}</option>)}
        </select>
      </label>
      <label class="flex flex-col gap-1 text-sm">
        <span class="text-muted">{t(lang, 'projects.filterPhase')}</span>
        <select name="phase" class="h-11 rounded-full border border-border bg-surface px-4">
          <option value="">{t(lang, 'projects.all')}</option>
          {phases.map((p) => <option value={p.id}>{p.order} · {phaseName(p, lang)}</option>)}
        </select>
      </label>
    </form>

    <div class="project-grid mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => <ProjectCard lang={lang} project={project} />)}
    </div>
    <p class="project-empty mt-10 text-muted" hidden>{t(lang, 'projects.empty')}</p>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('.project-filters');
  const cards = [...document.querySelectorAll<HTMLElement>('.project-grid > article')];
  const empty = document.querySelector<HTMLElement>('.project-empty');
  if (form) {
    form.hidden = false;
    const apply = () => {
      const data = new FormData(form);
      const status = String(data.get('status') ?? '');
      const phase = String(data.get('phase') ?? '');
      let visible = 0;
      for (const card of cards) {
        const show = (!status || card.dataset.status === status) && (!phase || card.dataset.phase === phase);
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (empty) empty.hidden = visible > 0;
    };
    form.addEventListener('change', apply);
  }
</script>
