---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialLinks from '../SocialLinks.astro';
import ObfuscatedEmail from '../public/ObfuscatedEmail.astro';
import { t, path, otherLang, type Lang } from '../../i18n';
import { SITE_CONFIG } from '../../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const hasLinks = Object.values(SITE_CONFIG.links).some(Boolean);
---
<BaseLayout lang={lang} title={t(lang, 'about.title')} alternateHref={path(otherLang(lang), 'about')} current="about">
  <div class="container-site pt-16">
    <h1 class="text-2xl md:text-3xl">{t(lang, 'about.title')}</h1>
    <div class="prose mt-8">
      <p>{t(lang, 'about.bio1')}</p>
      {SITE_CONFIG.showJob && <p>{t(lang, 'about.job')}</p>}
      <p>{t(lang, 'about.bio2')}</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <section class="card p-6" aria-labelledby="skills">
        <h2 id="skills" class="text-lg">{t(lang, 'about.skills')}</h2>
        <p class="mt-3 font-mono text-sm text-muted">{t(lang, 'about.skillsList')}</p>
        <h2 class="mt-6 text-lg">{t(lang, 'about.tools')}</h2>
        <p class="mt-3 font-mono text-sm text-muted">{t(lang, 'about.toolsList')}</p>
      </section>

      <section class="card p-6" aria-labelledby="contact">
        <h2 id="contact" class="text-lg">{t(lang, 'about.contact')}</h2>
        {
          hasLinks && (
            <p class="mt-3 flex flex-wrap gap-4">
              <SocialLinks />
            </p>
          )
        }
        {
          SITE_CONFIG.contactEmail && (
            <p class="mt-3">
              {t(lang, 'about.emailLabel')}:{' '}
              <ObfuscatedEmail
                user={SITE_CONFIG.contactEmail.user}
                domain={SITE_CONFIG.contactEmail.domain}
                label={t(lang, 'about.emailReveal')}
              />
            </p>
          )
        }
        <h2 class="mt-6 text-lg">{t(lang, 'about.cv')}</h2>
        <p class="mt-3 text-sm text-muted">
          {SITE_CONFIG.cvPath ? <a href={SITE_CONFIG.cvPath} class="link">{t(lang, 'about.cv')} (PDF)</a> : t(lang, 'about.cvSoon')}
        </p>
      </section>
    </div>

    <section class="mt-12 max-w-2xl border-l-2 border-border pl-4 text-sm text-muted" aria-labelledby="disclaimer">
      <h2 id="disclaimer" class="text-base text-text">{t(lang, 'about.disclaimerTitle')}</h2>
      <p class="mt-2">{t(lang, 'footer.disclaimer')}</p>
    </section>
  </div>
</BaseLayout>
