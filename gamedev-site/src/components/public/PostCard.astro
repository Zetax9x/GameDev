---
import { t, path, formatDate, type Lang } from '../../i18n';
import { postSlug, readingTime, type Post } from '../../lib/devlog';

interface Props {
  lang: Lang;
  post: Post;
}
const { lang, post } = Astro.props;
const minutes = readingTime(post.body ?? '');
---
<article class="relative border-b border-border py-6 first:pt-0">
  <p class="font-mono text-xs text-muted">
    <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(lang, post.data.date)}</time>
    · {minutes} {t(lang, 'devlog.readingTime')}
  </p>
  <h3 class="mt-1 text-xl">
    <a href={path(lang, 'devlog', postSlug(post))} class="no-underline hover:text-accent">{post.data.title}</a>
  </h3>
  <p class="mt-1 text-muted">{post.data.description}</p>
  {
    post.data.tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2" aria-label={t(lang, 'devlog.tags')}>
        {post.data.tags.map((tag) => (
          <li>
            <a href={path(lang, 'devlog', 'tag', tag)} class="pill text-muted no-underline hover:text-text">
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
