---
// Runs before paint to apply the saved theme and avoid a flash. Dark is the default.
---
<script is:inline>
  (function () {
    var theme = 'dark';
    try {
      var saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') theme = saved;
    } catch (e) {}
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>
