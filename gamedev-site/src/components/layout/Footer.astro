---
import { t, type Lang } from '../../i18n';
import { SITE_CONFIG } from '../../config/site';
import SocialLinks from '../SocialLinks.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-border">
  <div class="container-site flex flex-col gap-6 py-10 text-xs text-muted md:flex-row md:items-start md:justify-between">
    <div class="max-w-xl space-y-2">
      <p>{t(lang, 'footer.disclaimer')}</p>
      <p class="font-mono">© {year} {SITE_CONFIG.author}</p>
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <SocialLinks />
      <a href={`/${lang}/rss.xml`} class="link">{t(lang, 'footer.rss')}</a>
    </div>
  </div>
</footer>
