{
  "name": "yuri-gamedev",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:lan": "astro dev --host",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "astro build",
    "preview": "astro build && wrangler dev --persist-to .wrangler/state",
    "seed:generate": "node scripts/generate-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types --strict-vars=false",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "jose": "^6.2.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
