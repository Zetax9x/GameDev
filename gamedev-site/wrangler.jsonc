{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name: the public URL will be <name>.<account>.workers.dev
  "name": "yuri-gamedev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Preview URLs would expose private routes on an address not covered by Access.
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yuri-gamedev-db",
      // Replace with the real id after `npx wrangler d1 create yuri-gamedev-db` (Milestone 5).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Filled in at Milestone 5 (Cloudflare Access application).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
